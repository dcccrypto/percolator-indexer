# ── Network (required) ───────────────────────────────────────
# Which Solana network to index. Must be: devnet | testnet | mainnet
NETWORK=devnet

# Percolator program ID on the target network (required)
# v18 devnet wrapper (2026-09-22 fresh-ID cutover): GnwdeQrAh4qzChJeVLrM21CXXWC1akjLH3DiijwzEEYZ
# (the old v17 wrapper DhSkE7uTb8HBUYYWF1xkxMYBGtLYJEoDq1tfBD7SnHcj is ABANDONED)
PROGRAM_ID=

# Additional program IDs to scan (comma-separated, optional)
# ALL_PROGRAM_IDS=

# Set to "1" to allow mainnet operations (safety guard, required when NETWORK=mainnet)
# FORCE_MAINNET=

# ── Solana RPC (required in production) ──────────────────────
RPC_URL=https://api.devnet.solana.com

# Fallback RPC endpoint (optional)
# FALLBACK_RPC_URL=

# Origin header for RPC calls (optional). Some devnet Helius keys are
# Origin-restricted — e.g. the padre.gg-provisioned devnet key used elsewhere
# in the Percolator stack 401s "Unauthorized" on every call without this exact
# header. Only needed on devnet with such a key; leave unset on mainnet or with
# an unrestricted key. See ~/percolator-oracle-keeper/src/cross-cluster.ts and
# memory `percolator_devnet_rpc_helius_origin` for the pattern this mirrors.
# RPC_UPSTREAM_ORIGIN=https://trade.padre.gg

# ── Database (required in production) ────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Helius ───────────────────────────────────────────────────
# Generic Helius API key (optional — prefer network-specific keys below)
HELIUS_API_KEY=

# Network-specific Helius API keys (optional, override HELIUS_API_KEY)
# HELIUS_DEVNET_API_KEY=
# HELIUS_MAINNET_API_KEY=

# Webhook HMAC secret for verifying Helius payloads (required in production)
HELIUS_WEBHOOK_SECRET=

# Public URL where Helius sends webhook events (required for webhook registration)
# WEBHOOK_URL=

# ── Server ───────────────────────────────────────────────────
# NODE_ENV: development | production | test (default: development)
# NODE_ENV=development

# Port for the indexer HTTP server (default: 3002)
# INDEXER_PORT=3002

# ── Monitoring (optional) ────────────────────────────────────
# Sentry DSN for error tracking
# SENTRY_DSN=

# Discord webhook URL for operational alerts
# DISCORD_ALERT_WEBHOOK=
